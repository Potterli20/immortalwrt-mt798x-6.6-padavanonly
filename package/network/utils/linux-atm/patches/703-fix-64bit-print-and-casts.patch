+++ b/src/maint/atmaddr.c
@@ -97,7 +97,7 @@
     }
     if (cmd != ATM_GETADDR) return 0;
     if (req.length % sizeof(*addr)) {
-	fprintf(stderr,"internal error: len %d %% %d\n",req.length,
+	fprintf(stderr,"internal error: len %d %% %zu\n",req.length,
 	  sizeof(*addr));
