+++ b/src/include/atmd.h
@@ -146,7 +146,7 @@
 typedef struct {
     int	s;			/* socket */
     struct sockaddr_un addr;	/* reply address */
-    int size;			/* address size */
+    socklen_t size;		/* address size, as recvfrom/sendto want it */
 } UN_CTX;
 
 
