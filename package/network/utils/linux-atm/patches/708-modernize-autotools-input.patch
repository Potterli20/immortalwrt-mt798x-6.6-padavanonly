+AM_CPPFLAGS = -I$(srcdir)/../../q2931
 
 sw_tcp_SOURCES = tcpsw.c
 sw_tcp_XTRAS = $(top_builddir)/src/switch/libsw.a \
--- a/src/extra/Makefile.am
+++ b/src/extra/Makefile.am
@@ -15,7 +15,22 @@
 	$(INSTALL_DATA) $(srcdir)/pca200e_ecd.bin2 $(DESTDIR)/lib/firmware
 	$(INSTALL_DATA) $(srcdir)/sba200e_ecd.bin2 $(DESTDIR)/lib/firmware
 
-%.bin %.bin2: %.data
+# objcopy writes the gzip container and gzip -n -df immediately unpacks it,
+# so each firmware file lands next to its .data source.  These were a single
+# `%.bin %.bin2: %.data` pattern rule, which made GNU make warn that the
+# recipe never updates its peer target, and split in two they made automake
+# warn that %-style pattern rules are a GNU make extension.  BUILT_SOURCES
+# lists exactly three files, so naming them outright is shorter than either
+# pattern rule and needs no GNU extensions.
+pca200e.bin: $(srcdir)/pca200e.data
+	$(OBJCOPY) -Iihex $< -Obinary $@.gz
+	gzip -n -df $@.gz
+
+pca200e_ecd.bin2: $(srcdir)/pca200e_ecd.data
+	$(OBJCOPY) -Iihex $< -Obinary $@.gz
+	gzip -n -df $@.gz
+
+sba200e_ecd.bin2: $(srcdir)/sba200e_ecd.data
 	$(OBJCOPY) -Iihex $< -Obinary $@.gz
 	gzip -n -df $@.gz
 
