From 02f020823acfded75939847bad80c2cc807df0eb Mon Sep 17 00:00:00 2001
From: Mason Chang <mason-cw.chang@mediatek.com>
Date: Wed, 10 Sep 2025 14:43:12 +0800
Subject: [PATCH] net: ethernet: mtk_eth_soc: add skb mark support for qos

---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c | 3 +++
 1 file changed, 3 insertions(+)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -6016,6 +6016,9 @@ static u16 mtk_select_queue(struct net_d
 	struct mtk_mac *mac = netdev_priv(dev);
 	unsigned int queue = 0;
 
+	if (skb->mark > 0 && skb->mark < dev->num_tx_queues)
+		return skb->mark;
+
 	queue = mac->id ? 32 : 0;
 
 	if (queue >= dev->num_tx_queues)
