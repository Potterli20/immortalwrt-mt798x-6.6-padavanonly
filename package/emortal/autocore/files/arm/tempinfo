#!/bin/sh

[ -r "/etc/openwrt_release" ] && . "/etc/openwrt_release"

IEEE_PATH="/sys/class/ieee80211"
THERMAL_PATH="/sys/class/thermal"

get_mtwifi_temp() {
	local flag
	local ifname
	local temp
	local mtwifi_vifs="ra0 rax0 rai0 ray0 rae0 raz0"
	local result=""

	for ifname in $mtwifi_vifs; do
		if [ -f "/sys/class/net/${ifname}/flags" ]; then
			flag="$(cat "/sys/class/net/${ifname}/flags" 2>"/dev/null")"
			if [ -n "$flag" ] && [ "$((flag & 0x1))" -eq "1" ]; then
				temp="$(iwpriv "${ifname}" stat 2>"/dev/null" | awk '/CurrentTemperature/ {printf("%d°C", $3)}')"
				[ -n "$temp" ] || continue
				if [ -n "$result" ]; then
					result="${result}/${temp}"
				else
					result="${temp}"
				fi
			fi
		fi
	done
	echo "${result}"
}

get_hwmon_temp() {
	local pattern file raw temp result

	for pattern in "$IEEE_PATH"/phy*/device/hwmon/hwmon*/temp1_input \
		"$IEEE_PATH"/phy*/hwmon*/temp1_input \
		"$IEEE_PATH"/wl*/hwmon*/temp1_input; do
		for file in $pattern; do
			[ -e "$file" ] || continue
			raw="$(cat "$file" 2>"/dev/null")"
			# skip anything that is not a plain millidegree integer
			case "$raw" in
			''|*[!0-9]*) continue ;;
			esac
			temp="$(awk -v v="$raw" 'BEGIN { printf("%.1f°C", v / 1000) }')"
			if [ -n "$result" ]; then
				result="${result} ${temp}"
			else
				result="${temp}"
			fi
		done
	done
	echo "${result}"
}

case "$DISTRIB_TARGET" in
ipq40xx/*)
	wifi_temp="$(get_hwmon_temp)"
	# the vendor sensor on ipq40xx reports "Temperature: N" instead of a
	# millidegree integer, so append it the way autocore used to
	if [ -e "$IEEE_PATH/phy0/hwmon0/temp1_input" ]; then
		mt76_temp="$(awk -F ': ' '{print $2}' "$IEEE_PATH/phy0/hwmon0/temp1_input" 2>"/dev/null")"
		[ -n "$mt76_temp" ] && wifi_temp="${wifi_temp:+$wifi_temp }${mt76_temp}°C"
	fi
	;;
ipq806x/*)
	wifi_temp="$(get_hwmon_temp)"
	;;
mediatek/*)
	wifi_temp="$(get_mtwifi_temp)"
	[ -n "$wifi_temp" ] || wifi_temp="$(get_hwmon_temp)"
	;;
*)
	wifi_temp="$(get_hwmon_temp)"
	;;
esac

cpu_temp="$(awk '{printf("%.1f°C", $0 / 1000)}' "$THERMAL_PATH/thermal_zone0/temp" 2>"/dev/null")"

if [ -n "$cpu_temp" ] && [ -n "$wifi_temp" ]; then
	echo -n "CPU: ${cpu_temp}, WiFi: ${wifi_temp}"
elif [ -n "$cpu_temp" ]; then
	echo -n "CPU: ${cpu_temp}"
elif [ -n "$wifi_temp" ]; then
	echo -n "WiFi: ${wifi_temp}"
else
	echo -n " "
fi
