-	req.arg = (void *) mode;
+	req.arg = (void *)(unsigned long) mode;
 	req.length = 0;
 	if (ioctl(s,ATM_SETLOOP,&req) < 0) {
 	    perror("ioctl ATM_SETLOOP");
