From c2949064f2b702266dcc6779edc8a4ba2acec595 Mon Sep 17 00:00:00 2001
From: Yuzhii0718 <admin@yuzhii0718.eu.org>
Date: Sun, 3 May 2026 17:33:26 +0800
Subject: [PATCH] mediatek: mtk_eth_soc: Readd PPE number retrieval in mtk_open

---
 mtk_eth_soc.c | 2 ++
 1 file changed, 2 insertions(+)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -4263,6 +4263,8 @@ static int mtk_open(struct net_device *d
 	struct mtk_mac *target_mac;
 	int i, err, mtu, ppe_num;
 
+	ppe_num = eth->soc->ppe_num;
+
 	/* we run 2 netdevs on the same dma ring so we only bring it up once */
 	if (!refcount_read(&eth->dma_refcnt)) {
 		const struct mtk_soc_data *soc = eth->soc;
