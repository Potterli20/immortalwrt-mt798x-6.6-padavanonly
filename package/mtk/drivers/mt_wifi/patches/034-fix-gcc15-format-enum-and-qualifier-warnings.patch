 		pAd->MacTab.fPsSTAFlushManualMode = TRUE;
 		MtCmdPsStaFlushCtrl(pAd);
 		MTWF_PRINT("fPsSTAFlushEnable=%d, PsFlushThldTotalMsduNum=%d, PsFlushPerStaMaxMsduNum=%d\n",
